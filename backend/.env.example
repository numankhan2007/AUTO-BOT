# ═══════════════════════════════════════════════════════════════
# Shadow System Instagram Bot — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to Git. It contains secrets.
# ═══════════════════════════════════════════════════════════════

# ── Page Access Token ──
# How to obtain:
#   1. Go to https://developers.facebook.com/tools/explorer/
#   2. Select your App from the dropdown
#   3. Select your Page from the "User or Page" dropdown
#   4. Add permission: pages_messaging, instagram_manage_messages
#   5. Click "Generate Access Token" → this gives you a SHORT-LIVED token
#   6. Exchange it for a long-lived token using token_refresh.py:
#      python -c "import asyncio; from token_refresh import exchange_for_long_lived_token; print(asyncio.run(exchange_for_long_lived_token('YOUR_SHORT_TOKEN')))"
#   7. Paste the long-lived token below
PAGE_ACCESS_TOKEN="your_long_lived_page_access_token_here"

# ── App Secret ──
# How to obtain:
#   1. Go to https://developers.facebook.com/apps/YOUR_APP_ID/settings/basic/
#   2. Click "Show" next to "App Secret"
#   3. Copy the value
APP_SECRET="your_app_secret_here"

# ── Verify Token ──
# This is ANY string you choose. It must match EXACTLY what you enter
# in the Meta App Dashboard → Webhooks → "Verify Token" field.
# Use a strong, random string (e.g., generated via `openssl rand -hex 32`)
VERIFY_TOKEN="your_custom_verify_token_here"

# ── Instagram Account ID ──
# How to obtain:
#   1. Go to Graph API Explorer
#   2. Query: GET /me?fields=id,name with your Page token
#   3. The "id" field is your Page ID (also used for Instagram API routing)
INSTAGRAM_ACCOUNT_ID="your_instagram_account_id_here"

# ═══════════════════════════════════════════════════════════════
# Optional Configuration
# ═══════════════════════════════════════════════════════════════

# Meta Graph API version (default: v19.0)
# GRAPH_API_BASE="https://graph.facebook.com/v19.0"

# Server port (default: 8000)
# PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL="INFO"

# Token auto-refresh interval in days (default: 50, token expires at 60)
# TOKEN_REFRESH_DAYS=50

# ═══════════════════════════════════════════════════════════════
# AI Overlord Configuration — Gemini + Pollinations Integration
# ═══════════════════════════════════════════════════════════════

# ── Gemini API Key (REQUIRED) ──
# Get from: https://aistudio.google.com/app/apikeys
# IMPORTANT: Revoke and regenerate if this key is ever exposed in a screenshot or shared doc
GEMINI_API_KEY="your_google_ai_studio_api_key_here"

# ── Bot Username (REQUIRED) ──
# Your Instagram bot's username WITHOUT the @ symbol.
# Used for @mention detection in group chat messages.
# Example: if your bot is @shadow_system_bot, set this to: shadow_system_bot
BOT_USERNAME="your_instagram_bot_username_without_at_symbol"

# ── AI Cooldown (Optional, default: 30) ──
# How many seconds between AI requests per user (prevents spam and Meta API abuse)
# AI_COOLDOWN_SECONDS=30

# ── Pollinations.ai Base URL (Optional) ──
# Pollinations.ai is free, no API key required. Image is returned at the URL directly.
# Only change this if Pollinations changes their domain.
# POLLINATIONS_BASE_URL="https://image.pollinations.ai"
